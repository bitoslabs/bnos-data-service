{
	"name": "bnos-data-service",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "BNOS data service — encrypted backup, status, and reporting backend",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"migrate": "tsx src/scripts/migrate.ts",
		"migrate:prod": "node dist/scripts/migrate.js",
		"admin": "tsx src/admin/cli.ts",
		"worker": "tsx src/worker/index.ts",
		"worker:prod": "node dist/worker/index.js",
		"test": "vitest run",
		"test:unit": "vitest run test/unit",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.1",
		"@fastify/helmet": "^12.0.1",
		"@fastify/rate-limit": "^10.2.2",
		"@sinclair/typebox": "^0.34.33",
		"fastify": "^5.2.2",
		"kysely": "^0.27.6",
		"nostr-tools": "^2.17.0",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"@types/pg": "^8.11.10",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^2.1.8"
	}
}
