# bnos-data-service configuration
# Copy to .env and fill in values. Never commit real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
BASE_PATH=
LOG_LEVEL=info

# self-hosted | cloud
DEPLOYMENT_MODE=self-hosted
# Run pending migrations at startup. Set false when migrations are a separate step.
AUTO_MIGRATE=true

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bnos:change-me@127.0.0.1:5432/bnos
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Docker Compose database service (compose builds DATABASE_URL from these).
POSTGRES_DB=bnos
POSTGRES_USER=bnos
POSTGRES_PASSWORD=change-me

# ── Service identity ────────────────────────────────────────────────────────
SERVICE_ID=bnos-data-service
SERVICE_NAME=BNOS Data Service
# Stable audience bound into signed challenges. Must match the URL clients use.
SERVICE_AUDIENCE=http://127.0.0.1:8080

# Comma-separated allowed browser origins. Use explicit origins, never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth lifetimes (seconds) ────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CHALLENGE_TTL_SECONDS=300
INVITE_TTL_SECONDS=86400

# ── Ingest limits ───────────────────────────────────────────────────────────
MAX_EVENT_BYTES=524288
MAX_BATCH_SIZE=100
MAX_BODY_BYTES=2097152
MAX_EVENT_CLOCK_SKEW_SECONDS=900

# ── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=1 minute

# ── Features ────────────────────────────────────────────────────────────────
# Reject events whose content is not a recognized encryption envelope.
REQUIRE_ENCRYPTED_CONTENT=true
# Allow plaintext events too. Only for deployments that intentionally mirror
# public data; keep false when private backup is the goal.
ALLOW_PLAINTEXT_CONTENT=false
ENABLE_REPORTING=true
ENABLE_RELAY_INDEXER=false
# v1: must remain false. Opt-in server decryption is a separate reviewed feature.
ENABLE_SERVER_DECRYPTION=false

# ── Relay backfill (only when ENABLE_RELAY_INDEXER=true) ────────────────────
# Subscriptions are created per workspace with `pnpm admin add-relay`.
RELAY_BATCH_SIZE=200
RELAY_POLL_INTERVAL_MS=30000
RELAY_MAX_WAIT_MS=8000
RELAY_MAX_ROUNDS=50

# ── Reports ─────────────────────────────────────────────────────────────────
REPORT_MAX_RANGE_DAYS=400
REPORT_MAX_BUCKETS=2000

# ── Backups (self-hosted: local path; cloud: object storage via sidecar) ────
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/bnos-data-service
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14

# ── Admin CLI ───────────────────────────────────────────────────────────────
# The CLI uses DATABASE_URL directly. Do not expose admin actions over HTTP.
ADMIN_DEFAULT_WORKSPACE_NAME=My Shop
